+    def encode_all_layers(self, hidden_states, attention_mask=None):
+        """The encoder's output with every layer's hidden states, as transformers 4.x returned them.
+
+        transformers 5.x encoders no longer return per-layer hidden states, which InfiniteTalk needs, so
+        they are collected here by hand: the embeddings first, then each layer's output (CloneCraft patch).
+        """
+        from transformers.masking_utils import create_bidirectional_mask
+
+        encoder = self.encoder
+        assert not self.config.do_stable_layer_norm, "only the post-norm encoder is supported"
+        if attention_mask is not None:
+            hidden_states[~attention_mask.unsqueeze(-1).repeat(1, 1, hidden_states.shape[2])] = 0
+        attention_mask = create_bidirectional_mask(
+            config=self.config, inputs_embeds=hidden_states, attention_mask=attention_mask
+        )
+        hidden_states = hidden_states + encoder.pos_conv_embed(hidden_states).to(hidden_states.device)
+        hidden_states = encoder.dropout(encoder.layer_norm(hidden_states))
+        all_hidden_states = (hidden_states,)
+        for layer in encoder.layers:
+            hidden_states = layer(hidden_states, attention_mask=attention_mask)
+            all_hidden_states += (hidden_states,)
+        return BaseModelOutput(last_hidden_state=hidden_states, hidden_states=all_hidden_states, attentions=None)
+
